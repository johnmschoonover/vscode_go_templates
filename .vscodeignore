# Exclude development and build-only assets
.github/**
.vscode/**
.claude/**
src/**
test/**
vitest.config.ts
tsconfig.test.json
**/*.test.*
**/*.spec.*
# Worker test fixtures (sample copies, goldens, deliberately broken files) are not needed at runtime
go-worker/testdata/**
node_modules/**
.*
*.vsix

# Keep runtime and documentation assets
!.eslintrc.json
!dist/**
!assets/bin/**
!language-configuration.json
!README.md
!LICENSE
!assets/icon.png
!CHANGELOG.md
!syntaxes/**
