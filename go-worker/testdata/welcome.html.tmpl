{{/* Demonstrates the inner-.html rule (welcome.html.tmpl renders with html/template, no doctype needed) and a TOML context. */ -}}
<div style="font-family: Arial, sans-serif; max-width: 560px; margin: 0 auto; color: #1f2937;">
  {{- /* DisplayName in context/welcome.toml contains <script>alert(1)</script> on purpose: html/template escapes it, so the preview shows it as text and it never runs. */}}
  <h1 style="font-size: 22px;">Welcome to {{ .Product }}, {{ .DisplayName }}!</h1>
  <p>Here are a few links to get you started:</p>
  <ul>
    {{- range .Links }}
    <li><a href="{{ .URL }}">{{ .Title }}</a></li>
    {{- end }}
  </ul>
  <p>Questions? Write to <a href="mailto:{{ .SupportEmail }}">{{ .SupportEmail }}</a>.</p>
  <hr style="border: none; border-top: 1px solid #e5e7eb;" />
  <footer style="font-size: 12px; color: #6b7280;">
    {{- with .Footer }}
    <p>{{ .Company }} &middot; {{ .Address }}</p>
    <p><a href="{{ .Unsubscribe }}">Unsubscribe</a></p>
    {{- end }}
  </footer>
</div>
